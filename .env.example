# ── Application ──────────────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development          # development | production

# ── AI Reviewer ──────────────────────────────────────────────────────────────
# Supported providers: gemini, chat_completions.
AI_PROVIDER=gemini

# Gemini generateContent API. Do not commit real API keys.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
# Optional override; defaults to Google's public Gemini API.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# For AI_PROVIDER=chat_completions (Claude/OpenAI-compatible proxy):
# AI_BASE_URL=https://your-ai-api.com
# AI_TOKEN=your_ai_token_here
# AI_MODEL=claude-sonnet-4
AI_TIMEOUT_SECONDS=120

# Token pricing for cost calculation (USD per million tokens)
AI_PRICE_PER_M_INPUT_TOKENS=3.0
AI_PRICE_PER_M_OUTPUT_TOKENS=15.0

# Master key (base64-encoded 32 bytes) used to encrypt at rest the AI
# credentials configured through the frontend (API keys and OAuth tokens).
# Required only when you persist AI configs via the UI; the env-based config
# above does not use it. Generate with: openssl rand -base64 32
# AI_CONFIG_ENC_KEY=

# ── Agentic review (checkout da branch + tool-use) ────────────────────────────
# Usado quando um perfil de revisão tem a camada "agentic" ligada. O serviço
# clona a working tree do MR num diretório efêmero e deixa a IA navegar o código.
# Diretório raiz dos checkouts efêmeros (limpos ao fim de cada review):
WORKSPACE_DIR=./data/workspaces
# Profundidade do clone (0 = clone completo). Raso acelera; o SHA é buscado se faltar.
AGENTIC_CLONE_DEPTH=1
# Timeout total das operações git (clone/checkout), em segundos.
AGENTIC_TIMEOUT_SECONDS=120
# (Same-machine GitLab) Raiz do armazenamento @hashed para clonar do disco local
# em vez de pela rede. Vazio = sempre clone remoto via token. Ex.:
# GITLAB_REPOS_PATH=/var/opt/gitlab/git-data/repositories
GITLAB_REPOS_PATH=

# ── Sandbox de execução (Fase 2 — camada "execution" do perfil) ───────────────
# Quando um perfil tem "execution" ligado, a IA pode rodar comandos (testes/build)
# num contêiner Docker isolado: --network=none, --read-only, sem env/segredos.
# Vazio = execução desabilitada (a tool "run" não é exposta). Requer Docker.
SANDBOX_IMAGE=
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
SANDBOX_TIMEOUT_SECONDS=120

# ── Retry ─────────────────────────────────────────────────────────────────────
# Applies to the transient steps of the review pipeline: fetching the MR,
# fetching the diff, calling the AI reviewer and posting the comment. When
# every attempt fails, a comment explaining the error is posted on the MR
# inviting a manual "/review" retry later.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2

# ── Persistence ───────────────────────────────────────────────────────────────
DATABASE_PATH=./data/reviewer.db

# ── Platform clients ──────────────────────────────────────────────────────────
# Path to the JSON file that lists all Git platforms to monitor.
# See clients.example.json for the expected format.
# On first boot with an empty DB, clients from this file are seeded automatically.
CLIENTS_CONFIG_PATH=./clients.json

# ── Dashboard auth ────────────────────────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme
# A random secret is used if unset (tokens won't survive restarts)
DASHBOARD_JWT_SECRET=change-this-to-a-long-random-string

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info               # debug | info | warn | error
